{
  "name": "campushub-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "CampusHub Backend — Express on Vercel Serverless",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=server.js --watch-path=app.js --watch-path=.env --watch-path=config --watch-path=controllers --watch-path=middleware --watch-path=models --watch-path=routes --watch-path=services server.js",
    "lint": "eslint .",
    "seed": "node ../scripts/seed.js"
  },
  "dependencies": {
    "@google/genai": "^1.21.0",
    "argon2": "^0.31.2",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "eslint": "^9.17.0"
  },
  "allowScripts": {
    "argon2@0.31.2": true
  }
